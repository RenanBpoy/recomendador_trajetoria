APP_NAME=API do Recomendador de Trajetória
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=https://recomendador-trajetoria.vercel.app

# URI exibida em Supabase > Connect.
DATABASE_URL=postgresql://postgres.PROJECT_REF:SENHA@HOST_DO_POOLER:6543/postgres?sslmode=require

# transaction: Supavisor na porta 6543; direct: conexão direta ou pooler de sessão.
DATABASE_POOL_MODE=transaction
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_ECHO=false


# API pública do projeto Supabase. A chave publishable pode ser usada no cliente;
# nunca coloque uma service_role key no frontend.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_EXEMPLO

# Homologação local; a UFSM autentica no próprio portal.
UFSM_AUTH_ENABLED=false
UFSM_CLIENT_ID=ext-trajetoria-academica
UFSM_PORTAL_LOGIN_URL=https://sistemas-homolog.dti.ufsm.br/autenticacao/login
UFSM_REDIRECT_URI=http://localhost:5173/auth/callback
# Cursos adicionais consultados para ofertas equivalentes, além dos conhecidos no catálogo local.
UFSM_RECOMMENDATION_EXTRA_COURSES=307,312,314
# Informe o segredo apenas em api/.env (nunca use VITE_ para esse valor).
# UFSM_CLIENT_SECRET=
