APP_NAME=API do Recomendador de Trajetória
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

# URI exibida em Supabase > Connect.
DATABASE_URL=postgresql://postgres.PROJECT_REF:SENHA@HOST_DO_POOLER:6543/postgres?sslmode=require

# transaction: Supavisor na porta 6543; direct: conexão direta ou pooler de sessão.
DATABASE_POOL_MODE=transaction
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_ECHO=false

# API pública do projeto Supabase. A chave publishable pode ser usada no cliente;
# nunca coloque uma service_role key no frontend.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_EXEMPLO
